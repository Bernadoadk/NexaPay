# Neon (prod) : utiliser l'URL "pooled" + ?sslmode=require
# Ex. postgresql://user:pass@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/nexapay"
JWT_SECRET="change-this-secret-in-production"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# Compte administrateur du back-office (npm run db:seed).
# ADMIN_PASSWORD n'est utilisé qu'à la création : sur un compte existant, le
# seed accorde le rôle ADMIN sans toucher au mot de passe.
ADMIN_EMAIL="admin@votre-domaine.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Email (SMTP) — pour l'envoi des codes OTP et des devis
# Gmail : activer la 2FA puis créer un "mot de passe d'application" (16 caractères).
# Ne pas utiliser le mot de passe principal du compte Google.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="votre@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
# Optionnel — expéditeur affiché (défaut : "NexaPay" <SMTP_USER>)
SMTP_FROM="NexaPay <votre@gmail.com>"

# Google OAuth
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"

# Apple Sign-In
APPLE_CLIENT_ID="com.nexapay.app"

# Cloudinary (upload logos)
CLOUDINARY_CLOUD_NAME="xxxx"
CLOUDINARY_API_KEY="xxxx"
CLOUDINARY_API_SECRET="xxxx"

# Fedapay (encaissements Mobile Money + carte, reversements Mobile Money)
FEDAPAY_ENV="sandbox"
FEDAPAY_SECRET_KEY="xxxx"
# Opérateurs tentés pour un reversement, dans l'ordre. Le premier accepté gagne,
# ce qui évite de deviner l'opérateur d'après le préfixe du numéro.
FEDAPAY_PAYOUT_MODES="mtn_open,moov_open"
# Commission prélevée sur les encaissements par lien de paiement (0.03 = 3 %).
# La boutique a son propre taux, stocké sur Store.commissionRate.
QUOTE_COMMISSION_RATE="0.03"
# Secret du webhook FedaPay (wh_sandbox_... ou wh_live_...).
# FedaPay envoie automatiquement la signature dans X-FEDAPAY-SIGNATURE.
FEDAPAY_WEBHOOK_SHARED_SECRET="wh_sandbox_xxxx"

# Notifications système (Web Push). Générer une paire une seule fois :
#   npx web-push generate-vapid-keys
# Laisser vide désactive proprement le push (le front ne propose pas l'option).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@nexapay.app"

# OpenAI (fonctions IA — crédits)
OPENAI_API_KEY="sk-xxxx"
OPENAI_MODEL="gpt-4o-mini"

# Optionnel : catalogue complet des familles via l'API officielle Google Fonts.
GOOGLE_FONTS_API_KEY=""

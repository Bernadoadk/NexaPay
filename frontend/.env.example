# Prod recommandé : /api (proxy Vercel → nexapay-api, pas de CORS)
# Alternative directe : https://nexapay-api.vercel.app/api
VITE_API_URL=/api

# Notifications temps réel (optionnel). À ne renseigner que si l'API tourne sur
# un hôte qui supporte les WebSockets — Render, VPS… — jamais sur Vercel
# serverless. Laisser vide : le front rafraîchit alors par polling (30 s).
# Ex. VITE_WS_URL=wss://nexapay-api.onrender.com
VITE_WS_URL=

VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
VITE_APPLE_CLIENT_ID=com.nexapay.app
